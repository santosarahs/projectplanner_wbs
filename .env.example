# Postgres connection string. If you add the Neon integration from the Vercel
# dashboard (Storage -> Create Database -> Neon), this is injected automatically
# and you don't need to set it by hand.
POSTGRES_URL=

# API key for Resend (resend.com), used to send magic-link sign-in emails.
RESEND_API_KEY=

# Sender shown on the sign-in email. Until you verify your own domain in Resend,
# use their shared test address below.
EMAIL_FROM="Project Master <onboarding@resend.dev>"

# Comma-separated list of emails allowed to sign in.
ALLOWED_EMAILS=sarah.santos@villa.com.mv

# Random secret used to sign login/session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Public URL of the deployed app (e.g. https://projectplanner-wbs.vercel.app).
# Used to build the link inside the sign-in email. Not required in local dev.
BASE_URL=
